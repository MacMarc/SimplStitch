    "H" : {
      "shouldTranslate" : false
    },
    "hint.fillNeedsUnderlay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllungen brauchen eine Unterlage: Sie verbindet Stoff und Vlies und verhindert, dass die Stiche einsinken oder sich der Stoff verzieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fills need an underlay: it binds fabric and stabilizer and keeps stitches from sinking in or distorting the fabric."
          }
        }
      }
    },
    "hint.fillTooDense" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So dicht wird die Fläche steif und das Garn kann reissen. Üblich sind 0,25 bis 0,5 mm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This dense the area gets stiff and the thread may break. 0.25 to 0.5 mm is usual."
          }
        }
      }
    },
    "hint.fillTooSmall" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr schmale Flächen werden mit Füllung unruhig. Satin passt besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very narrow areas look messy as a fill. Satin works better."
          }
        }
      }
    },
    "hint.fillTooSparse" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei so grossem Reihenabstand scheint der Stoff durch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With rows this far apart the fabric shows through."
          }
        }
      }
    },
    "hint.fillUnderlayOptional" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei so lockerer Füllung ist keine Unterlage nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fill this open does not need an underlay."
          }
        }
      }
    },
    "hint.runningStitchTooLong" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange Stiche runden Kurven ab und können hängen bleiben. Üblich sind etwa 2,5 mm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long stitches flatten curves and can snag. About 2.5 mm is usual."
          }
        }
      }
    },
    "hint.runningStitchTooShort" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr kurze Stiche perforieren den Stoff und lassen das Garn reissen. Üblich sind etwa 2,5 mm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very short stitches perforate the fabric and break the thread. About 2.5 mm is usual."
          }
        }
      }
    },
    "hint.satinTooDense" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So dichter Satin wird steif und das Garn kann reissen. Üblich sind etwa 0,4 mm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satin this dense gets stiff and the thread may break. About 0.4 mm is usual."
          }
        }
      }
    },
    "hint.satinTooNarrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 1,5 mm Breite wird Satin kaum mehr als ein Strich. Ein Laufstich passt besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satin narrower than 1.5 mm barely shows. A running stitch works better."
          }
        }
      }
    },
    "hint.satinTooSparse" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei so grossem Abstand deckt der Satin nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With this spacing the satin no longer covers."
          }
        }
      }
    },
    "hint.satinTooWide" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satin über 8 mm liegt lose auf und verhakt sich leicht. Eine Füllung (Tatami) hält besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satin wider than 8 mm lies loose and snags easily. A fill (tatami) holds better."
          }
        }
      }
    },
    "hint.satinUnderlay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Breite empfiehlt Ink/Stitch eine andere Unterlage: bis 2 mm Mittelsteg, bis 4 mm Randsteg, darüber Randsteg mit Zickzack."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink/Stitch recommends a different underlay for this width: center walk up to 2 mm, edge walk up to 4 mm, edge walk plus zigzag above that."
          }
        }
      }
    },
    "imageTrace.error.noShapes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Bild wurden keine Formen gefunden. Versuche mehr Farben, oder lass den Hintergrund drin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No shapes were found in the image. Try more colors, or keep the background."
