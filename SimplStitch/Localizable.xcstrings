    "imageTrace.sheet.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimplStitch reduziert das Bild auf wenige Garnfarben und legt für jede Farbfläche eine bearbeitbare Form mit passendem Stichtyp an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimplStitch reduces the image to a few thread colors and creates an editable shape with a suitable stitch type for each color area."
          }
        }
      }
    },
