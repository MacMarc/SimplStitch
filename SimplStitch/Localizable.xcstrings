    "imageTrace.sheet.advisor.ai" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence wählt pro Fläche Stichart und Stichrichtung. Unterlage, Dichte und Garn kommen aus den Stickregeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence picks stitch type and direction for each area. Underlay, density and thread come from the embroidery rules."
          }
        }
      }
    },
    "imageTrace.sheet.advisor.rules" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
